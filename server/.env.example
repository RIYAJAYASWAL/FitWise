# FitWise Node API Server Configuration

# Server Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/fitwise

# ML Service Settings
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=5000
ML_INTERNAL_KEY=dev-internal-key-secret-123

# Internal Service Shared Key
INTERNAL_KEY=dev-internal-key-secret-123

# CORS Allowed Origins (comma-separated or single domain)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Redis Cache & Queue
REDIS_URL=redis://localhost:6379

# Optional: Background Cron Jobs (true / false)
ENABLE_CRON=false

# Chart Doctor Aggregation Thresholds
CHART_MIN_ORDERS=30
CHART_THRESHOLD=0.25

# Environment
NODE_ENV=development
